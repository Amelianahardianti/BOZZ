# For local development, point this at the Docker PostgreSQL instance
# (see root README.md — "Installation & Setup"):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pos_platform"
#
# For a Supabase-backed environment, use the shared transaction-mode pooler
# (IPv4-only) connection string from your own Supabase project settings —
# replace every [PLACEHOLDER] below with your project's own values:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (used for migrations) — same placeholders as above.
# For local development this can be identical to DATABASE_URL.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:5432/postgres"

JWT_SECRET=ganti-dengan-secret-asli

# Domain PWA yang boleh akses API ini (pisahkan pakai koma kalau lebih
# dari satu). Default-nya (kalau env ini kosong) sudah pas buat dev
# lokal (localhost:5173/5174) -- di production isi domain PWA yang
# sebenarnya, mis. https://pos-pwa.pages.dev
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Orang B (backend/src/modules/ecommerce-sync) ---

# 64 hex chars (32 bytes) — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# true = pakai fixture, tanpa perlu credential (SRS: Mock Marketplace Data Layer)
MOCK_SHOPEE=true
MOCK_TIKTOK=true

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=
SHOPEE_AUTH_HOST=
SHOPEE_REDIRECT_URI=

TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_HOST=
TIKTOK_AUTH_HOST=
TIKTOK_REDIRECT_URI=

# FakeStoreAPI — tidak butuh credential, opsional override
FAKESTORE_REDIRECT_URI=
