PORT=

# 64 hex chars (32 bytes) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# true = use fixture data instead of calling the real platform (no credentials needed)
MOCK_SHOPEE=true
MOCK_TIKTOK=true

# Shopee — on hold (no partner key yet)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=
SHOPEE_AUTH_HOST=
SHOPEE_REDIRECT_URI=

# TikTok Shop — from your app in partner.tiktokshop.com
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_HOST=
TIKTOK_AUTH_HOST=
TIKTOK_REDIRECT_URI=

# FakeStoreAPI — no credentials needed, optional override (defaults to localhost:3000)
FAKESTORE_REDIRECT_URI=

DATABASE_URL="postgresql://..."
