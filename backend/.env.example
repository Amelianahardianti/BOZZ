# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.aircofjgyqpsjviddrmb:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.aircofjgyqpsjviddrmb:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

JWT_SECRET=ganti-dengan-secret-asli

# Domain PWA yang boleh akses API ini (pisahkan pakai koma kalau lebih
# dari satu). Default-nya (kalau env ini kosong) sudah pas buat dev
# lokal (localhost:5173/5174) -- di production isi domain PWA yang
# sebenarnya, mis. https://pos-pwa.pages.dev
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Orang B (backend/src/modules/ecommerce-sync) ---

# 64 hex chars (32 bytes) — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# true = pakai fixture, tanpa perlu credential (SRS: Mock Marketplace Data Layer)
MOCK_SHOPEE=true
MOCK_TIKTOK=true

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=
SHOPEE_AUTH_HOST=
SHOPEE_REDIRECT_URI=

TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_HOST=
TIKTOK_AUTH_HOST=
TIKTOK_REDIRECT_URI=

# FakeStoreAPI — tidak butuh credential, opsional override
FAKESTORE_REDIRECT_URI=
