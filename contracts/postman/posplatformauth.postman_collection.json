    {
      "name": "6. Notifications",
      "description": "Endpoint POST buat notifikasi tidak ada (memang disengaja) -- notifikasi dibuat dari dalam backend saja lewat createNotification(), dipanggil modul Sales & Inventory (assign ticket) & Order Hub (order baru masuk). Jadi request di folder ini cuma bisa uji struktur response, RBAC (semua role login boleh akses), dan validasi -- bukan alur bikin notifikasi sampai jadi data beneran.",
      "item": [
        {
          "name": "List Notifications - Sebagai Owner (harus 200, array)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response berupa array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_token}}" }],
            "url": { "raw": "{{base_url}}/notifications", "host": ["{{base_url}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "List Notifications - Filter is_read=false (harus 200, array)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response berupa array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_token}}" }],
            "url": {
              "raw": "{{base_url}}/notifications?is_read=false&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["notifications"],
              "query": [
                { "key": "is_read", "value": "false" },
                { "key": "page", "value": "1" },
